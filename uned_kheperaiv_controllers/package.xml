<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uned_kheperaiv_controllers</name>
  <version>0.0.0</version>
  <description>C++ controllers for the Khepera IV, for teaching: periodic PID and event-based PID position control, and event triggering. Ported from the benchmark branch (developed there for a book chapter, never carried over to humble-dev until now).</description>
  <maintainer email="fma527@ual.es">Francisco José Mañas Álvarez</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
