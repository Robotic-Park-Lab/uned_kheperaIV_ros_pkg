<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uned_kheperaiv_config</name>
  <version>0.0.0</version>
  <description>Environment configuration for the Khepera IV: 3D models, the unified experience.launch.py launch file, and RViz/RQT resources</description>
  <maintainer email="fma527@ual.es">Francisco José Mañas Álvarez</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- URDF generation (urdf/khepera.xml -> kheperaXX.urdf), merged in from
       the former uned_khepera_description package -->
  <depend>urdf</depend>
  <depend>xacro</depend>

  <!-- experience.launch.py imports these for real -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>webots_ros2_driver</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
